{"id": "t2-001", "task": "t2_politeness_anger", "state": "商品受け取りました。ありがとうございました。", "context": null, "label": 0, "label_b": null, "agreed": null, "source": "llm_assisted", "variant_of": null, "variant_type": null, "note": "お礼"}
{"id": "t2-002", "task": "t2_politeness_anger", "state": "発送はいつ頃になりそうでしょうか。予定だけ教えていただけると助かります。", "context": null, "label": 0, "label_b": null, "agreed": null, "source": "llm_assisted", "variant_of": null, "variant_type": null, "note": "中立の問い合わせ"}
{"id": "t2-003", "task": "t2_politeness_anger", "state": "ご丁寧にありがとうございます。それでは明日の午前中に発送いたします。", "context": null, "label": 0, "label_b": null, "agreed": null, "source": "llm_assisted", "variant_of": null, "variant_type": null, "note": "通常連絡"}
{"id": "t2-004", "task": "t2_politeness_anger", "state": "写真を追加しましたので、ご確認ください。", "context": null, "label": 0, "label_b": null, "agreed": null, "source": "llm_assisted", "variant_of": null, "variant_type": null, "note": "通常連絡"}
{"id": "t2-005", "task": "t2_politeness_anger", "state": "お返事が遅くなってすみません。週末は家を空けておりました。", "context": null, "label": 0, "label_b": null, "agreed": null, "source": "llm_assisted", "variant_of": null, "variant_type": null, "note": "謝罪"}
{"id": "t2-006", "task": "t2_politeness_anger", "state": "値段交渉は可能ですか？難しければこのままでも大丈夫です。", "context": null, "label": 0, "label_b": null, "agreed": null, "source": "llm_assisted", "variant_of": null, "variant_type": null, "note": "中立の問い合わせ"}
{"id": "t2-007", "task": "t2_politeness_anger", "state": "無事に届いてよかったです。大切に使っていただけたらうれしいです。", "context": null, "label": 0, "label_b": null, "agreed": null, "source": "llm_assisted", "variant_of": null, "variant_type": null, "note": "お礼"}
{"id": "t2-008", "task": "t2_politeness_anger", "state": "在庫を確認しますので、少々お待ちください。", "context": null, "label": 0, "label_b": null, "agreed": null, "source": "llm_assisted", "variant_of": null, "variant_type": null, "note": "通常連絡"}
{"id": "t2-009", "task": "t2_politeness_anger", "state": "了解です、では駅前で18時にお願いします。", "context": null, "label": 0, "label_b": null, "agreed": null, "source": "llm_assisted", "variant_of": null, "variant_type": null, "note": "通常連絡"}
{"id": "t2-010", "task": "t2_politeness_anger", "state": "サイズ表記は実寸で測ったものです。参考になれば幸いです。", "context": null, "label": 0, "label_b": null, "agreed": null, "source": "llm_assisted", "variant_of": null, "variant_type": null, "note": "通常連絡"}
{"id": "t2-011", "task": "t2_politeness_anger", "state": "届いた商品ですが、説明にはなかった汚れが少しありました。次回からは気をつけていただけると助かります。", "context": null, "label": 1, "label_b": null, "agreed": null, "source": "llm_assisted", "variant_of": null, "variant_type": null, "note": "穏やかな苦情"}
{"id": "t2-012", "task": "t2_politeness_anger", "state": "発送予定日を過ぎているようですが、状況を教えていただけますか。", "context": null, "label": 1, "label_b": null, "agreed": null, "source": "llm_assisted", "variant_of": null, "variant_type": null, "note": "穏やかな催促"}
{"id": "t2-013", "task": "t2_politeness_anger", "state": "正直なところ、写真の印象とは少し違いました。まあ中古品なので仕方ないですね。", "context": null, "label": 1, "label_b": null, "agreed": null, "source": "llm_assisted", "variant_of": null, "variant_type": null, "note": "落胆"}
{"id": "t2-014", "task": "t2_politeness_anger", "state": "前回もお伝えしたのですが、時間指定は夜でお願いできればと思います。", "context": null, "label": 1, "label_b": null, "agreed": null, "source": "llm_assisted", "variant_of": null, "variant_type": null, "note": "穏やかな念押し"}
{"id": "t2-015", "task": "t2_politeness_anger", "state": "梱包が少し簡易的で、箱がつぶれていました。中身は無事だったので大丈夫です。", "context": null, "label": 1, "label_b": null, "agreed": null, "source": "llm_assisted", "variant_of": null, "variant_type": null, "note": "穏やかな苦情"}
{"id": "t2-016", "task": "t2_politeness_anger", "state": "お返事がなかなかいただけず、少し困っています。お手すきの際にご連絡ください。", "context": null, "label": 1, "label_b": null, "agreed": null, "source": "llm_assisted", "variant_of": null, "variant_type": null, "note": "穏やかな催促"}
{"id": "t2-017", "task": "t2_politeness_anger", "state": "残念ですが、今回は評価を『普通』にさせていただきます。", "context": null, "label": 1, "label_b": null, "agreed": null, "source": "llm_assisted", "variant_of": null, "variant_type": null, "note": "落胆"}
{"id": "t2-018", "task": "t2_politeness_anger", "state": "値下げ後すぐに別の方へ売られてしまったのは、少し残念でした。", "context": null, "label": 1, "label_b": null, "agreed": null, "source": "llm_assisted", "variant_of": null, "variant_type": null, "note": "落胆"}
{"id": "t2-019", "task": "t2_politeness_anger", "state": "付属品が一つ足りないようです。お手数ですがご確認いただけますか。", "context": null, "label": 1, "label_b": null, "agreed": null, "source": "llm_assisted", "variant_of": null, "variant_type": null, "note": "穏やかな苦情"}
{"id": "t2-020", "task": "t2_politeness_anger", "state": "説明文をもう少し詳しく書いていただけると、購入する側としては助かります。", "context": null, "label": 1, "label_b": null, "agreed": null, "source": "llm_assisted", "variant_of": null, "variant_type": null, "note": "穏やかな要望"}
{"id": "t2-021", "task": "t2_politeness_anger", "state": "何度ご連絡差し上げてもお返事がいただけないのは、どういうおつもりでしょうか。本日中にご回答がない場合、運営に報告いたします。", "context": null, "label": 2, "label_b": null, "agreed": null, "source": "llm_assisted", "variant_of": null, "variant_type": null, "note": "丁寧語の最後通告"}
{"id": "t2-022", "task": "t2_politeness_anger", "state": "大変恐縮ではございますが、これ以上の言い訳は結構です。代金を全額お返しください。", "context": null, "label": 2, "label_b": null, "agreed": null, "source": "llm_assisted", "variant_of": null, "variant_type": null, "note": "丁寧語の強い抗議"}
{"id": "t2-023", "task": "t2_politeness_anger", "state": "説明文に『美品』と書かれていたかと存じますが、こちらのどこが美品なのか、ぜひご教示いただけますでしょうか。", "context": null, "label": 2, "label_b": null, "agreed": null, "source": "llm_assisted", "variant_of": null, "variant_type": null, "note": "丁寧語の皮肉"}
{"id": "t2-024", "task": "t2_politeness_anger", "state": "ご丁寧なお詫び文、拝読いたしました。三度目ともなりますと、さすがに言葉もございません。", "context": null, "label": 2, "label_b": null, "agreed": null, "source": "llm_assisted", "variant_of": null, "variant_type": null, "note": "丁寧語の憤り"}
{"id": "t2-025", "task": "t2_politeness_anger", "state": "もう結構です。二度とお取引させていただくことはございませんので、ご安心ください。", "context": null, "label": 2, "label_b": null, "agreed": null, "source": "llm_assisted", "variant_of": null, "variant_type": null, "note": "丁寧語の絶縁"}
{"id": "t2-026", "task": "t2_politeness_anger", "state": "こちらは発送日を守ってお待ちしておりました。約束を守れないのであれば、最初から出品なさらないでいただけますか。", "context": null, "label": 2, "label_b": null, "agreed": null, "source": "llm_assisted", "variant_of": null, "variant_type": null, "note": "丁寧語の強い抗議"}
{"id": "t2-027", "task": "t2_politeness_anger", "state": "お言葉ですが、壊れた状態で送ってきたのはそちらです。責任を持って対応していただきます。", "context": null, "label": 2, "label_b": null, "agreed": null, "source": "llm_assisted", "variant_of": null, "variant_type": null, "note": "強い抗議"}
{"id": "t2-028", "task": "t2_politeness_anger", "state": "重ねて申し上げます。これ以上の遅延は一切容認いたしかねます。", "context": null, "label": 2, "label_b": null, "agreed": null, "source": "llm_assisted", "variant_of": null, "variant_type": null, "note": "丁寧語の最後通告"}
{"id": "t2-029", "task": "t2_politeness_anger", "state": "これで三回目の連絡です。いい加減にしていただけませんか。", "context": null, "label": 2, "label_b": null, "agreed": null, "source": "llm_assisted", "variant_of": null, "variant_type": null, "note": "強い苛立ち"}
{"id": "t2-030", "task": "t2_politeness_anger", "state": "誠意あるご対応を期待しておりましたが、期待した私が愚かでした。然るべき対応を取らせていただきます。", "context": null, "label": 2, "label_b": null, "agreed": null, "source": "llm_assisted", "variant_of": null, "variant_type": null, "note": "丁寧語の憤り"}
